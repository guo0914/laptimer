# 统一换行符：Shell / Swift / YAML 必须用 LF，
# 否则在 macOS 上执行 .sh 会因 CRLF 报 "bad interpreter"。
* text=auto eol=lf

*.swift text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.plist text eol=lf
*.xcprivacy text eol=lf
*.json text eol=lf
*.md text eol=lf

# 二进制资源不要做换行转换
*.png binary
*.jpg binary
*.ipa binary
*.xcarchive binary
